# ── App ─────────────────────────────────────────────
APP_URL=http://localhost:3000
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── AI core (optional — without a key JARVIS runs on the rule-based backup brain) ──
AI_PROVIDER=anthropic          # anthropic | google | openai
AI_MODEL=                      # optional override
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# ── Google (Calendar + Drive) ───────────────────────
# OAuth Web client. Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=        # optional: Tony's own chat id, for reminder pings

# ── Voice (optional; without it JARVIS uses the browser's built-in voice) ──
# elevenlabs.io → API Keys → create a key with Text to Speech permission.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=           # optional: default is premade "George" (library voices need a paid plan)
ELEVENLABS_MODEL=              # optional: default eleven_flash_v2_5 (lowest latency)
ELEVENLABS_CHAR_BUDGET=        # optional: hard cap on characters sent (default 12000; cached lines are free)

# ── Storage (optional; set on Vercel, local dev uses .data/*.json) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
